; Round-trip tests for the source-position FDO profile format
; ([Source_position_profile] in ocamlcommon).

(executable
 (name source_position_profile_test)
 (modules source_position_profile_test)
 (libraries ocamlcommon))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (run ./source_position_profile_test.exe)))

(executable
 (name gen_profile)
 (modules gen_profile)
 (libraries ocamlcommon))

(executable
 (name fdo_decode_test)
 (modules fdo_decode_test)
 (libraries fdo_decode_lib))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (run ./fdo_decode_test.exe)))

; Deterministic test of -fdo-profile cold-block sinking: build a profile
; that marks one branch of hot_cold.ml hot, compile with it, and check the
; resulting block layouts.

(executable
 (name filter_fdo_dump)
 (modules filter_fdo_dump))

(rule
 (targets hot_cold.fdo)
 (deps hot_cold_profile.txt gen_profile.exe)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (run ./gen_profile.exe hot_cold_profile.txt hot_cold.fdo)))

(rule
 (targets hot_cold.output.corrected)
 (deps hot_cold.ml hot_cold.fdo filter_fdo_dump.exe)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (progn
   (with-outputs-to
    hot_cold.output.raw
    (run %{bin:ocamlopt.opt} -c -g -fdo-profile hot_cold.fdo -dcfg -dfdo -color
      never hot_cold.ml))
   (with-outputs-to
    hot_cold.output.corrected
    (run ./filter_fdo_dump.exe hot_cold.output.raw)))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (deps hot_cold.output hot_cold.output.corrected)
 (action
  (diff hot_cold.output hot_cold.output.corrected)))

; End-to-end test through the runtime's single-stepping LBR emulator (see
; runtime/singlestep_profiler.c, x86-64 Linux only): compile specialize.ml
; with labels, run it collecting a complete trace of its hot part, decode the
; trace into a profile and check it (specialize.profile), recompile with it,
; and check the block frequencies and layouts (specialize.output).

(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (target specialize.exe)
 (deps specialize.ml)
 (action
  (run %{bin:ocamlopt.opt} -O3 -fdo-labels -fdo-names -ccopt -no-pie
    specialize.ml -o specialize.exe)))

(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (targets specialize.lbr specialize.run)
 (deps specialize.exe)
 (action
  (with-outputs-to
   specialize.run
   (run ./specialize.exe specialize.lbr))))

(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (target specialize.fdo)
 (deps specialize.lbr specialize.exe)
 (action
  (run %{bin:oxcaml-fdo-decode} -ip-ranges -perf-script-output specialize.lbr
    -binary specialize.exe -o specialize.fdo)))

; The decoded profile itself: its trie of locations and counts, named after
; the executable's -fdo-names metadata.
(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (target specialize.profile.corrected)
 (deps specialize.fdo specialize.exe)
 (action
  (with-outputs-to
   specialize.profile.corrected
   (run %{bin:oxcaml-fdo-decode} -dump specialize.fdo -binary specialize.exe))))

(rule
 (alias runtest)
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (deps specialize.profile specialize.profile.corrected)
 (action
  (diff specialize.profile specialize.profile.corrected)))

; Depends on specialize.exe so that the two compilations of specialize.ml,
; which both write specialize.cm*, are sequenced.
(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (target specialize.output.corrected)
 (deps specialize.ml specialize.fdo specialize.exe filter_fdo_dump.exe)
 (action
  (progn
   (with-outputs-to
    specialize.dump
    (run %{bin:ocamlopt.opt} -O3 -fdo-profile specialize.fdo -dcfg -dfdo
      -color never -c specialize.ml))
   (with-outputs-to
    specialize.output.corrected
    (run ./filter_fdo_dump.exe specialize.dump)))))

(rule
 (alias runtest)
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (deps specialize.output specialize.output.corrected)
 (action
  (diff specialize.output specialize.output.corrected)))

; Function reordering: the pass-1 compilation also hands the linker a call graph
; profile (see backend/fdo_call_graph.ml), which lld lays the functions out by.
; Link with lld and check the order it prints (the edges themselves are in
; specialize.output, from -dfdo). Needs lld: set OXCAML_LLD to enable. Depends on
; specialize.output.corrected to be sequenced after the other compilations of
; specialize.ml.
(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")
   (<> %{env:OXCAML_LLD=} "")))
 (targets specialize_lld.exe specialize.order.corrected)
 (deps specialize.ml specialize.fdo specialize.output.corrected)
 (action
  (progn
   (run %{bin:ocamlopt.opt} -O3 -fdo-profile specialize.fdo -ccopt -no-pie
     -ccopt -fuse-ld=lld -ccopt -Wl,--call-graph-profile-sort=hfsort -ccopt
     -Wl,--print-symbol-order=specialize.order.all specialize.ml -o
     specialize_lld.exe)
   (with-outputs-to
    specialize.order.corrected
    (run grep camlSpecialize specialize.order.all)))))

(rule
 (alias runtest)
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")
   (<> %{env:OXCAML_LLD=} "")))
 (deps specialize.order specialize.order.corrected)
 (action
  (diff specialize.order specialize.order.corrected)))
